{
  "name": "workspace",
  "version": "0.0.0",
  "license": "MIT",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "preinstall": "node preinstall.js",
    "build": "pnpm -r --if-present run build",
    "build:web": "pnpm --filter @workspace/mesh-web run build",
    "build:mobile": "pnpm --filter @workspace/mobile run build",
    "build:api": "pnpm --filter @workspace/api-server run build",
    "dev": "pnpm --filter @workspace/mesh-web run dev",
    "dev:web": "pnpm --filter @workspace/mesh-web run dev",
    "dev:mobile": "pnpm --filter @workspace/mobile run dev",
    "dev:sandbox": "pnpm --filter @workspace/mockup-sandbox run dev",
    "dev:api": "pnpm --filter @workspace/api-server run dev",
    "typecheck:web": "pnpm --filter @workspace/mesh-web run typecheck",
    "typecheck:mobile": "pnpm --filter @workspace/mobile run typecheck",
    "typecheck:libs": "tsc --build",
    "typecheck": "pnpm run typecheck:libs && pnpm -r --filter \"./artifacts/**\" --filter \"./scripts\" --if-present run typecheck",
    "format": "prettier --write \"**/*.{ts,tsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,json,md}\""
  },
  "devDependencies": {
    "prettier": "^3.8.1",
    "typescript": "~5.9.2"
  }
}
