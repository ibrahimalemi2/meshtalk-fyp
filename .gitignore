# ==============================================================================
# Monorepo .gitignore
# ==============================================================================

# Dependencies & Package Managers
node_modules/
.pnpm-store/
.pnpm-debug.log*
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Build Outputs & Caches
dist/
build/
out/
out-tsc/
tmp/
*.tsbuildinfo
.cache/
.sass-cache/
.vite/
coverage/

# Expo & React Native
.expo/
.expo-shared/
web-build/
*.jks
*.p8
*.p12
*.key
*.keystore
*.mobileprovision

# Native Mobile Build Artifacts
*.apk
*.aab
*.ipa
android/.gradle/
android/build/
android/app/build/
ios/build/
ios/Pods/
ios/*.xcworkspace/xcuserdata/

# Environment Variables & Secrets
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
!*.env.example

# IDEs & Editors
.idea/
.project
.classpath
.settings/
*.sublime-workspace
*.sublime-project
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# Operating System Files
.DS_Store
.DS_Store?
._*
Thumbs.db
ehthumbs.db
desktop.ini
$RECYCLE.BIN/

# Replit Specific
.local/

# Vercel & Backups
.vercel/
*.bak

# Ensure workspace source folders are tracked
!artifacts/
!lib/
!scripts/
